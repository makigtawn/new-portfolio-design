# Local-only example values. Replace these before deploying; do not commit real secrets.
ADMIN_PASSWORD=portfolio-test-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Fine-grained GitHub token with Contents read/write permission for this repo only.
GITHUB_TOKEN=replace-with-fine-grained-token
GITHUB_REPO=owner/repository
GITHUB_BRANCH=main
GITHUB_API_URL=https://api.github.com

# Canonical origin used to build sitemap and metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional local Playwright overrides (defaults: PORT=3020, base URL on that port).
# PORT=3020
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3020
